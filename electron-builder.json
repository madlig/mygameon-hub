{
  "appId": "com.mygameon.studio",
  "productName": "MyGameON Studio",
  "asar": true,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    ".next/standalone/**/*",
    "public/**/*",
    "lib/**/*",
    "models/**/*",
    "scripts/**/*"
  ],
  "extraMetadata": {
    "main": "main.js"
  },
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": {
    "provider": "github",
    "owner": "madlig",
    "repo": "mygameon-hub"
  }
}
