{
  "appId": "com.mygameon.studio",
  "productName": "MyGameON Studio",
  "asar": false,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "package.json",
    ".next/standalone/**/*",
    "public/**/*",
    ".env.local"
  ],
  "extraMetadata": {
    "main": "main.js"
  },
  "win": {
    "target": "squirrel"
  },
  "squirrelWindows": {
    "iconUrl": "https://mygameon-hub.vercel.app/icon.ico",
    "loadingGif": "build/install-spinner.gif"
  },
  "publish": {
    "provider": "github",
    "owner": "madlig",
    "repo": "mygameon-hub"
  }
}
