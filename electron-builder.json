{
  "appId": "com.mygameon.studio",
  "productName": "MyGameON Studio",
  "asar": true,
  "asarUnpack": [
    ".next/standalone/**/*"
  ],
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    ".next/standalone/**/*",
    "public/**/*",
    "lib/**/*",
    "models/**/*",
    "scripts/**/*",
    "build/**/*"
  ],
  "extraResources": [
    {
      "from": ".env.local",
      "to": ".env.local"
    }
  ],
  "extraMetadata": {
    "main": "main.js"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "madlig",
    "repo": "mygameon-hub"
  }
}
