{
  "name": "mygameon-hub",
  "version": "0.1.1",
  "author": "MyGameON",
  "description": "MyGameON Studio Desktop App",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:electron": "concurrently -k \"npm run dev\" \"electron .\"",
    "build:electron": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.rmSync('.next', {recursive:true, force:true});\" && npm run build && node scripts/resolve-symlinks.js && electron-builder",
    "release:patch": "npm version patch && npm run build:electron",
    "release:minor": "npm version minor && npm run build:electron",
    "release:major": "npm version major && npm run build:electron"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.14.0",
    "mongoose": "^9.9.2",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  }
}
